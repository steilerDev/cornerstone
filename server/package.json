{
  "name": "@cornerstone/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsc -b && npm run copy-migrations && concurrently -k -n tsc,node -c yellow,blue \"tsc -b --watch --preserveWatchOutput\" \"node --watch dist/server.js\"",
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "node scripts/copyMigrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npm run copy-migrations && node dist/db/runMigrate.js"
  },
  "dependencies": {
    "@cornerstone/shared": "*",
    "@fastify/compress": "9.2.2",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "ical-generator": "11.1.2",
    "node-cron": "4.6.0",
    "openid-client": "6.8.8",
    "sharp": "0.35.5",
    "tar": "^7.5.17",
    "vcard-creator": "1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}

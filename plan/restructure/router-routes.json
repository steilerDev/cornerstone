    { "path": "/settings", "guard": "member", "kind": "redirect", "target": "/settings/manage" },
    { "path": "/settings/backups", "guard": "admin", "kind": "page", "element": "BackupsPage" },
    { "path": "/settings/manage", "guard": "member", "kind": "page", "element": "ManagePage" },

      "kind": "page",
      "element": "MilestoneDetailPage"
    },
    {
      "path": "/project/milestones/new",
      "guard": "member",
      "kind": "page",
      "element": "MilestoneCreatePage"
    },
    { "path": "/project/overview", "guard": "member", "kind": "page", "element": "DashboardPage" },
    {
      "path": "/project/work-items",
      "guard": "member",
      "kind": "page",
      "element": "WorkItemsPage"
    },
    {
      "path": "/project/work-items/:id",
      "guard": "member",
      "kind": "page",
      "element": "WorkItemDetailPage"
    },
    {
      "path": "/project/work-items/new",
      "guard": "member",
      "kind": "page",
      "element": "WorkItemCreatePage"
    },
    { "path": "/schedule", "guard": "member", "kind": "redirect", "target": "/schedule/gantt" },
    { "path": "/schedule/calendar", "guard": "member", "kind": "page", "element": "TimelinePage" },
    { "path": "/schedule/gantt", "guard": "member", "kind": "page", "element": "TimelinePage" },
    {
      "path": "/schedule/milestones",
      "guard": "member",
      "kind": "redirect",
      "target": "/project/milestones"
    },
    {
      "path": "/schedule/milestones/:id",
      "guard": "member",
      "kind": "redirect",

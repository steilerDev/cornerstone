{
  "routes": [
    { "path": "*", "guard": "member", "kind": "page", "element": "NotFoundPage" },
    { "path": "/", "guard": "member", "kind": "redirect", "target": "/project/overview" },
    { "path": "/admin/users", "guard": "member", "kind": "redirect", "target": "/settings/users" },
